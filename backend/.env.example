# ---------------------------------------------------------------------------
# Backend environment configuration
# Copy this file to `.env` and replace the placeholders with real values.
# Never commit `.env` - it is excluded by .gitignore.
# ---------------------------------------------------------------------------

# Port the Express API listens on. Render supplies PORT automatically.
PORT=5000

# Interface the API binds to. Use 0.0.0.0 on Render and most containers.
HOST=0.0.0.0

# MongoDB Atlas connection string.
# Atlas UI -> Database -> Connect -> Drivers -> copy the SRV connection string,
# then replace <username>, <password>, and the database name.
# Include the database name before the query string, for example:
# mongodb+srv://user:pass@cluster.example.mongodb.net/authflow?retryWrites=true&w=majority
# If omitted, MongoDB uses the default "test" database.
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_URL

# Secret used to sign JWTs. Use a long random value (at least 32 characters).
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=YOUR_LONG_RANDOM_SECRET

# Browser origin allowed by CORS (no trailing slash).
# Multiple origins may be comma-separated.
# In production, use the deployed Vercel URL, for example:
# FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# development | production
NODE_ENV=development

# Cookie policy. Production defaults to "none" because Vercel and Render are
# different sites. Set to "lax" only when the frontend and API share a site.
# Allowed values: lax | strict | none
COOKIE_SAME_SITE=lax

# Password reset is disabled unless a mail transport is configured.
# Set to false to disable password reset even when email is configured.
PASSWORD_RESET_ENABLED=true

# Reset links expire after this many minutes (1-60, default 15).
RESET_TOKEN_EXPIRY_MINUTES=15

# Email delivery for password reset links. Use an app-specific SMTP password,
# never your primary mailbox password. Gmail example:
#   EMAIL_SERVICE=gmail
#   EMAIL_USER=your-address@gmail.com
#   EMAIL_PASS=your-google-app-password
# For another provider, omit EMAIL_SERVICE and set EMAIL_HOST/EMAIL_PORT.
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=AuthFlow <no-reply@example.com>
